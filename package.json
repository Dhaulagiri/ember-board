{
  "name": "ember-board",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:runtime && vite --port ${BOARD_PORT:-5320} --strictPort",
    "build": "pnpm build:runtime && vite build",
    "preview": "vite preview --port ${BOARD_PORT:-5320} --strictPort",
    "bench": "node bench/run.ts",
    "typecheck": "ember-tsc --noEmit",
    "vendor": "node scripts/vendor-ui-sdk.mjs",
    "build:runtime": "vite build -c vite.runtime.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.14",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@glimmer/component": "^2.2.1",
    "@glimmer/tracking": "^1.1.2",
    "@ui-sdk/core": "link:./vendor/@ui-sdk/core",
    "@ui-sdk/ember": "link:./vendor/@ui-sdk/ember",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "content-tag": "^4.2.1",
    "decorator-transforms": "^2.4.0",
    "ember-source": "~7.4.0",
    "lucide": "1.54.0"
  },
  "devDependencies": {
    "@glint/ember-tsc": "^1.14.3",
    "@glint/template": "^1.11.1",
    "@types/node": "^24.19.2",
    "es-module-lexer": "^2.3.2",
    "playwright": "1.63.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.3"
  },
  "packageManager": "pnpm@10.34.5"
}
